erDiagram
    ligas ||--o{ liga_equipo : "tiene"
    equipos ||--o{ liga_equipo : "juega en"
    equipos ||--o{ jugadores : "plantel"
    ligas ||--o{ importaciones_liga : "auditoría"
    usuarios ||..o{ model_has_roles : "polimórfica, sin FK"
    roles ||--o{ model_has_roles : ""
    roles ||--o{ role_has_permissions : ""
    permissions ||--o{ role_has_permissions : ""
    usuarios ||..o{ oauth_access_tokens : "sesiones (lógica, sin FK)"

    ligas {
        bigint id PK "id de football-data"
        text nombre
        varchar codigo UK "PL, PD, SA..."
        varchar tipo
        text emblema
        varchar plan "TIER_ONE..FOUR"
        text area_nombre
        varchar area_codigo
        text area_bandera
        date temporada_inicio
        date temporada_fin
        smallint jornada_actual
        timestamp equipos_sincronizados_en "null = no importada (indexado)"
    }
    equipos {
        bigint id PK "id de football-data"
        text nombre "btree + trigram GIN"
        text nombre_corto
        varchar sigla
        text escudo
        text estadio
        smallint fundacion
        text colores
        text entrenador
    }
    liga_equipo {
        bigint liga_id PK, FK
        bigint equipo_id PK, FK "+ índice propio"
        varchar temporada
    }
    jugadores {
        bigint id PK "id de football-data"
        bigint equipo_id FK "indexado"
        text nombre "btree + trigram GIN"
        text posicion
        smallint numero_camiseta "nullable"
        date fecha_nacimiento
        text nacionalidad
    }
    importaciones_liga {
        bigint id PK
        bigint liga_id FK "índice (liga_id, importado_en)"
        int cantidad_equipos
        int cantidad_jugadores
        varchar origen "peticion/cola/manual/programada/consola"
        timestamp importado_en
    }
    usuarios {
        bigint id PK
        varchar nombre
        varchar correo UK "único en lower(correo)"
        varchar contrasena "bcrypt"
        boolean activo
        timestamp desactivado_en
    }
    roles {
        bigint id PK
        varchar name "admin, analista, consulta..."
        varchar guard_name "api"
    }
    permissions {
        bigint id PK
        varchar name "ligas.ver, usuarios.crear..."
        varchar guard_name "api"
    }
    model_has_roles {
        bigint role_id FK
        bigint model_id "id del usuario (polimórfica)"
    }
    role_has_permissions {
        bigint permission_id FK
        bigint role_id FK
    }
    oauth_access_tokens {
        varchar id PK
        bigint user_id "indexado, sin FK (Passport)"
        boolean revoked
        timestamp expires_at
    }
