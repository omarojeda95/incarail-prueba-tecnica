flowchart TD
    peticion["GET /competitions/{id}<br/>(o job / scheduler)"] --> local{"¿La liga está<br/>importada y vigente<br/>(< 12 h)?"}
    local -- sí --> db["Responder desde PostgreSQL<br/><b>0 peticiones externas</b><br/>meta.fuente = base_de_datos"]
    local -- no --> plan{"¿Su plan está en<br/>FOOTBALL_DATA_AVAILABLE_PLANS?"}
    plan -- no --> e403["403 liga_fuera_del_plan<br/><b>sin gastar petición</b>"]
    plan -- sí --> presupuesto{"PresupuestoPeticiones.reservar()<br/>¿< 10 peticiones en los<br/>últimos 60 s? (Redis + lock)"}
    presupuesto -- sí --> llamada["ClienteFootballData<br/>GET /competitions/{id}/teams"]
    llamada --> cabeceras["Leer X-Requests-Available-Minute<br/>y X-RequestCounter-Reset<br/>→ si llega a 0, agotarPor(reinicio)"]
    cabeceras --> resp{"Respuesta"}
    resp -- 200 --> guardar["Upsert liga, equipos,<br/>jugadores · evento LigaImportada"] --> r200["200 · meta.fuente = football-data"]
    resp -- 429 --> limite
    resp -- "timeout / 5xx" --> caido
    presupuesto -- no --> limite["LimiteDePeticionesAlcanzado(reintentarEn)"]
    limite --> cola["Encolar ImportarLigaJob<br/>(único por liga)"]
    cola --> hayLocal{"¿Hay copia local<br/>aunque esté vencida?"}
    hayLocal -- sí --> vieja["200 con datos guardados<br/>meta.desactualizado = true"]
    hayLocal -- no --> e429["429 football_data_limite_alcanzado<br/>Retry-After · en_cola = true<br/>la SPA reintenta sola al terminar la cuenta"]
    caido["ProveedorNoDisponible"] --> hayLocal2{"¿Hay copia local?"}
    hayLocal2 -- sí --> vieja
    hayLocal2 -- no --> e503["503 football_data_no_disponible<br/>(502 si respondió con error)"]
    cola -.-> worker["Worker: el job usa la misma lógica;<br/>si no hay cupo hace release(reintentarEn)<br/>y vuelve a la cola sin perder la importación"]

    classDef bien fill:#e6f4ea,stroke:#2e7d32,color:#222
    classDef aviso fill:#fff4e0,stroke:#ef8f00,color:#222
    classDef mal fill:#fdecea,stroke:#c62828,color:#222
    class db,r200,vieja bien
    class e429,cola,worker aviso
    class e403,e503 mal
