flowchart TD
    req["GET /competitions/{id}<br/>(o job / scheduler)"] --> local{"¿La liga está<br/>importada y fresca<br/>(< 12 h)?"}
    local -- sí --> db["Responder desde PostgreSQL<br/><b>0 requests externos</b><br/>meta.source = database"]
    local -- no --> plan{"¿Su plan está en<br/>FOOTBALL_DATA_AVAILABLE_PLANS?"}
    plan -- no --> e403["403 competition_not_in_plan<br/><b>sin gastar request</b>"]
    plan -- sí --> budget{"RequestBudget.acquire()<br/>¿< 10 requests en los<br/>últimos 60 s? (Redis + lock)"}
    budget -- sí --> fetch["FootballDataClient<br/>GET /competitions/{id}/teams"]
    fetch --> headers["Leer X-Requests-Available-Minute<br/>y X-RequestCounter-Reset<br/>→ si llega a 0, exhaustFor(reset)"]
    headers --> resp{"Respuesta"}
    resp -- 200 --> save["Upsert competencia, equipos,<br/>jugadores · evento CompetitionImported"] --> r200["200 · meta.source = football-data"]
    resp -- 429 --> limited
    resp -- "timeout / 5xx" --> down
    budget -- no --> limited["FootballDataRateLimited(retryAfter)"]
    limited --> queue["Encolar ImportCompetitionJob<br/>(único por liga)"]
    queue --> hasLocal{"¿Hay copia local<br/>aunque esté vencida?"}
    hasLocal -- sí --> stale["200 con datos guardados<br/>meta.stale = true"]
    hasLocal -- no --> e429["429 football_data_rate_limited<br/>Retry-After · queued = true<br/>la SPA reintenta sola al terminar la cuenta"]
    down["FootballDataUnavailable"] --> hasLocal2{"¿Hay copia local?"}
    hasLocal2 -- sí --> stale
    hasLocal2 -- no --> e503["503 football_data_unavailable<br/>(502 si respondió con error)"]
    queue -.-> worker["Worker: el job llama a la misma lógica;<br/>si no hay cupo hace release(retryAfter)<br/>y vuelve a la cola sin perder la importación"]

    classDef good fill:#e6f4ea,stroke:#2e7d32,color:#222
    classDef warn fill:#fff4e0,stroke:#ef8f00,color:#222
    classDef bad fill:#fdecea,stroke:#c62828,color:#222
    class db,r200,stale good
    class e429,queue,worker warn
    class e403,e503 bad
