{
  "info": {
    "name": "Inca Rail · Plataforma de fútbol",
    "description": "API de la prueba técnica. Primero ejecuta «Iniciar sesión (admin)»: guarda el token en la variable {{token}} y el resto de las peticiones lo usa. Cambia {{baseUrl}} si levantaste la API en otro puerto.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8001"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Sesión",
      "item": [
        {
          "name": "Iniciar sesión (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/iniciar-sesion",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "iniciar-sesion"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"admin@incarail.test\",\n  \"contrasena\": \"password\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const cuerpo = pm.response.json();",
                  "if (cuerpo.token_acceso) { pm.collectionVariables.set('token', cuerpo.token_acceso); }",
                  "pm.test('devuelve un token', () => pm.expect(cuerpo.token_acceso).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Iniciar sesión (consulta, solo lectura)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/iniciar-sesion",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "iniciar-sesion"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"consulta@incarail.test\",\n  \"contrasena\": \"password\"\n}"
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Útil para ver los 403 de las rutas de administración."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const cuerpo = pm.response.json();",
                  "if (cuerpo.token_acceso) { pm.collectionVariables.set('token', cuerpo.token_acceso); }",
                  "pm.test('devuelve un token', () => pm.expect(cuerpo.token_acceso).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Sesión actual (usuario y reglas CASL)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/sesion",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "sesion"
              ]
            }
          }
        },
        {
          "name": "Cerrar sesión (revoca el token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/cerrar-sesion",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "cerrar-sesion"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Fútbol (los 5 endpoints del enunciado)",
      "item": [
        {
          "name": "Ligas",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/competitions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "competitions"
              ]
            }
          }
        },
        {
          "name": "Ligas disponibles en el plan gratuito",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/competitions?disponibles=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "competitions"
              ],
              "query": [
                {
                  "key": "disponibles",
                  "value": "1"
                }
              ]
            }
          }
        },
        {
          "name": "Detalle de una liga (la importa si hace falta)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/competitions/PL",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "competitions",
                "PL"
              ]
            },
            "description": "La primera vez hace 1 petición a football-data y guarda equipos y jugadores; las siguientes 12 h responde desde la base (meta.fuente)."
          }
        },
        {
          "name": "Equipos guardados",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
