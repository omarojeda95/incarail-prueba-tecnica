              "raw": "{{baseUrl}}/team",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "team"
              ]
            }
          }
        },
        {
          "name": "Selecciones guardadas",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/team?tipo=seleccion",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "team"
              ],
              "query": [
                {
                  "key": "tipo",
                  "value": "seleccion"
                }
              ]
            }
          }
        },
        {
          "name": "Detalle de un equipo (Arsenal)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/team/57",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "team",
                "57"
              ]
            }
          }
        },
        {
          "name": "Jugadores guardados",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/players",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "players"
              ]
            }
          }
        },
        {
          "name": "Arqueros",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/players?posicion=Goalkeeper&orden=nombre",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "players"
              ],
              "query": [
                {
                  "key": "posicion",
                  "value": "Goalkeeper"
                },
                {
                  "key": "orden",
                  "value": "nombre"
                }
              ]
            }
          }
        },
        {
          "name": "Forzar la actualización de una liga (en cola)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/competitions/PL/importar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "competitions",
                "PL",
                "importar"
              ]
            },
            "description": "Requiere el permiso ligas.importar (admin o analista). Responde 202."
          }
        }
      ]
    },
    {
