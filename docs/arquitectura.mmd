flowchart LR
    user(["👤 Usuario<br/>móvil / escritorio"])

    subgraph browser["Navegador"]
        spa["<b>SPA Vue 3</b><br/>Vue Router · Pinia · Vuetify<br/>TypeScript · CASL<br/><i>token Bearer en localStorage</i>"]
    end

    subgraph docker["Docker Compose (Linux)"]
        nginx["<b>nginx</b><br/>:8081 SPA estática + proxy /api<br/>:8001 API"]

        subgraph api["API Laravel 13 · PHP-FPM 8.5"]
            direction TB
            http["<b>HTTP</b><br/>auth:api (Passport) · active · can:permiso<br/>Form Requests · Controllers delgados<br/>Resources · ApiExceptionRenderer"]
            app["<b>Aplicación</b><br/>Comandos: ImportCompetition, SyncCompetitionCatalog<br/>Consultas: CompetitionCatalog, CompetitionDetail,<br/>TeamQueries, PlayerQueries<br/>Acceso: IssueAccessToken, UserManagement, RoleManagement"]
            domain["<b>Dominio</b><br/>Puerto FootballDataProvider<br/>DTOs · Excepciones · Evento CompetitionImported"]
            infra["<b>Infraestructura</b><br/>FootballDataClient (adaptador HTTP)<br/>SlidingWindowRequestBudget"]
            http --> app --> domain
            infra -. implementa .-> domain
        end

        worker["<b>Worker</b><br/>queue:work<br/>ImportCompetitionJob<br/>(release hasta que haya cupo)"]
        scheduler["<b>Scheduler</b><br/>sync catálogo diario<br/>refresh ligas vencidas c/hora"]
        pg[("<b>PostgreSQL</b><br/>Eloquent: competitions, teams,<br/>players, competition_team<br/>users · roles · permissions<br/>oauth_* (Passport)")]
        redis[("<b>Redis</b><br/>caché · cola<br/><b>presupuesto 10 req/min</b><br/>(ventana deslizante + lock)")]
    end

    fd["<b>football-data.org</b><br/>API v4 · X-Auth-Token<br/>10 req/min (plan gratuito)"]

    user --> spa
    spa -- "HTTPS JSON<br/>Authorization: Bearer" --> nginx
    nginx -- FastCGI --> http
    app -- Eloquent --> pg
    infra -- "acquire() antes de cada llamada" --> redis
    infra -- "1 request por liga" --> fd
    app -- "dispatch job si no hay cupo" --> redis
    worker -- consume --> redis
    worker --> app
    scheduler --> app

    classDef ext fill:#fff4e0,stroke:#c8963e,color:#333
    classDef store fill:#e8f1f8,stroke:#0b3c5d,color:#333
    class fd ext
    class pg,redis store
