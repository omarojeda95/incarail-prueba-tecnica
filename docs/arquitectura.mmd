flowchart LR
    usuario(["👤 Usuario<br/>móvil / escritorio"])

    subgraph navegador["Navegador"]
        spa["<b>SPA Vue 3</b><br/>Vue Router · Pinia · Vuetify<br/>TypeScript · CASL<br/><i>token Bearer en localStorage</i>"]
    end

    subgraph docker["Docker Compose (Linux)"]
        nginx["<b>nginx</b><br/>:8081 SPA estática + proxy /api<br/>:8001 API"]

        subgraph api["API Laravel 13 · PHP-FPM 8.5"]
            direction TB
            http["<b>HTTP</b><br/>auth:api (Passport) · activo · can:permiso<br/>Form Requests · Controladores delgados<br/>Resources · RenderizadorErroresApi"]
            aplicacion["<b>Aplicacion</b><br/>Comandos: ImportarLiga, SincronizarCatalogoLigas<br/>Consultas: CatalogoLigas, DetalleLiga,<br/>ConsultasEquipos, ConsultasJugadores<br/>Acceso: EmitirTokenAcceso, GestionUsuarios, GestionRoles"]
            dominio["<b>Dominio</b><br/>Puerto ProveedorDatosFutbol<br/>DTOs · Excepciones · Evento LigaImportada"]
            infra["<b>Infraestructura</b><br/>ClienteFootballData (adaptador HTTP)<br/>PresupuestoVentanaDeslizante"]
            http --> aplicacion --> dominio
            infra -. implementa .-> dominio
        end

        worker["<b>Worker</b><br/>queue:work<br/>ImportarLigaJob<br/>(release hasta que haya cupo)"]
        scheduler["<b>Scheduler</b><br/>sincroniza catálogo a diario<br/>refresca ligas vencidas c/hora<br/>passport:purge a diario"]
        pg[("<b>PostgreSQL</b><br/>Eloquent: ligas, equipos,<br/>liga_equipo, jugadores, importaciones_liga<br/>usuarios · roles · permissions<br/>oauth_* (Passport)")]
        redis[("<b>Redis</b><br/>caché · cola<br/><b>presupuesto 10 req/min</b><br/>(ventana deslizante + lock)")]
    end

    fd["<b>football-data.org</b><br/>API v4 · X-Auth-Token<br/>10 req/min (plan gratuito)"]

    usuario --> spa
    spa -- "HTTPS JSON<br/>Authorization: Bearer" --> nginx
    nginx -- FastCGI --> http
    aplicacion -- Eloquent --> pg
    infra -- "reservar() antes de cada llamada" --> redis
    infra -- "1 petición por liga" --> fd
    aplicacion -- "encola el job si no hay cupo" --> redis
    worker -- consume --> redis
    worker --> aplicacion
    scheduler --> aplicacion

    classDef externo fill:#fff4e0,stroke:#c8963e,color:#333
