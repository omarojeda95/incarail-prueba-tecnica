APP_NAME="Inca Rail Football API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Docker uses PostgreSQL (see compose.yml). For a quick manual run you can use
# DB_CONNECTION=sqlite and remove the other DB_* lines.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=incarail
DB_USERNAME=incarail
DB_PASSWORD=incarail

# Redis holds the cache, the queue and the shared football-data request budget.
# Without Redis use CACHE_STORE=database and QUEUE_CONNECTION=database.
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=array
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Origins allowed to call the API from a browser (Vite dev server).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081

# Lifetime of the access token issued on login (minutes).
PASSPORT_TOKEN_TTL_MINUTES=480

# --- football-data.org --------------------------------------------------------
# Personal token from https://www.football-data.org/client/register
# Never commit it: it only belongs in your local .env.
FOOTBALL_DATA_TOKEN=
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4
FOOTBALL_DATA_MAX_REQUESTS_PER_MINUTE=10
FOOTBALL_DATA_AVAILABLE_PLANS=TIER_ONE
FOOTBALL_COMPETITIONS_TTL_MINUTES=1440
FOOTBALL_COMPETITION_DETAIL_TTL_MINUTES=720
